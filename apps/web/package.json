{
  "name": "@flow/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build --prefix ../../packages/commercial",
    "prebuild": "npm run build --prefix ../../packages/commercial",
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:e2e": "node --env-file=../../.env.local node_modules/@playwright/test/cli.js test",
    "test:e2e:install": "playwright install chromium",
    "test:a11y": "node --env-file=../../.env.local node_modules/@playwright/test/cli.js test e2e/accessibility",
    "test:visual": "node --env-file=../../.env.local node_modules/@playwright/test/cli.js test e2e/visual",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "capture:phase2": "node --env-file=../../.env.local scripts/capture-phase2-screenshots.mjs"
  },
    "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.511.0",
    "@flow/commercial": "workspace:*",
    "@flow/contracts": "workspace:*",
    "@rjsf/core": "^5.24.8",
    "@rjsf/utils": "^5.24.8",
    "@rjsf/validator-ajv8": "^5.24.8",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "1.51.0",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "storybook": "^8.6.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vite": "^6.3.5"
  }
}
