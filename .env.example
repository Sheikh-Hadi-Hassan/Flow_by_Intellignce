# Public frontend values
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only values. Never expose service-role credentials to frontend code.
DATABASE_URL=
DATABASE_POOLER_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
FLOW_DB_INTEGRATION_TESTS=0

# API
API_PORT=4000
# Do not set NODE_ENV here — Next.js sets it per command (dev vs build).

# Optional real-model BLM evaluation. Leave disabled for ordinary CI.
BLM_REAL_MODEL_TESTS=0
OPENAI_API_KEY=
BLM_OPENAI_MODEL=
BLM_OPENAI_TIMEOUT_MS=30000
BLM_OPENAI_MAX_RETRIES=2
GROQ_API_KEY=
BLM_GROQ_MODEL=openai/gpt-oss-120b
BLM_GROQ_TIMEOUT_MS=30000
BLM_GROQ_MAX_RETRIES=2
