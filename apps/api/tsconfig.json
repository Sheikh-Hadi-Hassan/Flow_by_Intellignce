{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@flow/auth": ["../../packages/auth/dist/index.d.ts"],
      "@flow/contracts": ["../../packages/contracts/dist/index.d.ts"],
      "@flow/database": ["../../packages/database/dist/index.d.ts"],
      "@flow/commercial": ["../../packages/commercial/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
